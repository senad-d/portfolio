---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Senad | DevOps Portfolio',
  description = 'Single-page DevOps portfolio built with Astro and Tailwind.',
  ogImage = '/og-image.svg',
} = Astro.props;

const pageBaseUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, pageBaseUrl).toString();
const resolvedOgImage = new URL(ogImage, pageBaseUrl).toString();

const navLinks = [
  { href: '#home', label: 'Home' },
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#certifications', label: 'Certifications' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#030409" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400..700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <title>{title}</title>
  </head>
  <body class="page-shell">
    <a href="#main-content" class="skip-link focus-ring">Skip to content</a>
    <header class="site-header" data-site-header>
      <nav class="site-nav" aria-label="Primary navigation">
        <a
          href="#home"
          class="brand-link focus-ring"
          aria-label="Senad Dizdarevic — home"
        >
          <span aria-hidden="true">
            <span class="brand-prompt">❯</span>senad<span class="brand-host"
              >@dizdarevic</span
            >:~<span class="brand-cursor">_</span>
          </span>
        </a>

        <button
          type="button"
          class="nav-toggle focus-ring"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="primary-nav-links"
          aria-label="Open navigation menu"
        >
          <span class="sr-only">Toggle navigation menu</span>
          <span class="nav-toggle-icon" aria-hidden="true">
            <span class="nav-toggle-line"></span>
            <span class="nav-toggle-line"></span>
            <span class="nav-toggle-line"></span>
          </span>
        </button>

        <ul id="primary-nav-links" class="nav-links" role="list" data-nav-list>
          {
            navLinks.map((link, index) => (
              <li>
                <a
                  href={link.href}
                  data-nav-link
                  aria-current={index === 0 ? 'true' : undefined}
                  class:list={[
                    'nav-link',
                    'focus-ring',
                    index === 0 && 'is-active',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <canvas class="signal-canvas" aria-hidden="true" data-signal-canvas></canvas>

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <script>
      (() => {
        const header = document.querySelector('[data-site-header]');
        const navToggle = document.querySelector('[data-nav-toggle]');
        const navList = document.querySelector('[data-nav-list]');
        const desktopMediaQuery = window.matchMedia('(min-width: 1024px)');

        const headerElement = header instanceof HTMLElement ? header : null;
        const navToggleButton =
          navToggle instanceof HTMLButtonElement ? navToggle : null;

        const navLinks = Array.from(
          document.querySelectorAll('[data-nav-link]'),
        ).filter(
          (link): link is HTMLAnchorElement =>
            link instanceof HTMLAnchorElement,
        );

        // ── Canvas starfield ──────────────────────────────────────────────
        // Deep-space background: three parallax star layers with twinkle
        // plus occasional shooting stars. The canvas stays viewport-sized;
        // layers translate against scroll at different speeds for depth.
        const starCanvas = document.querySelector('[data-signal-canvas]');
        const starCtx =
          starCanvas instanceof HTMLCanvasElement
            ? starCanvas.getContext('2d')
            : null;

        type StarTint = 'white' | 'cyan' | 'violet' | 'warm';

        interface Star {
          x: number;
          y: number;
          r: number;
          tint: StarTint;
          baseAlpha: number;
          phase: number;
          speed: number;
          glow: boolean;
        }

        interface Meteor {
          x: number;
          y: number;
          vx: number;
          vy: number;
          life: number;
          maxLife: number;
        }

        const STAR_TINT_RGB: Record<StarTint, readonly [number, number, number]> = {
          white:  [226, 235, 255],
          cyan:   [125, 226, 247],
          violet: [186, 156, 255],
          warm:   [255, 214, 170],
        };

        // Pre-rendered sprites (dot + halo per tint). drawImage of a tiny
        // sprite is far cheaper than per-frame arc rasterization, and halo
        // sprites avoid per-frame createRadialGradient calls entirely.
        // Alpha is applied at draw time via globalAlpha.
        const DOT_SPRITE_HALF = 8;
        const HALO_SPRITE_HALF = 40;

        const makeSprite = (
          half: number,
          draw: (context: CanvasRenderingContext2D, half: number) => void,
        ) => {
          const sprite = document.createElement('canvas');
          sprite.width = half * 2;
          sprite.height = half * 2;
          const context = sprite.getContext('2d');
          if (context) draw(context, half);
          return sprite;
        };

        const buildSprites = () => {
          const dots = {} as Record<StarTint, HTMLCanvasElement>;
          const halos = {} as Record<StarTint, HTMLCanvasElement>;

          (Object.keys(STAR_TINT_RGB) as StarTint[]).forEach((tint) => {
            const [r, g, b] = STAR_TINT_RGB[tint];

            dots[tint] = makeSprite(DOT_SPRITE_HALF, (context, half) => {
              context.fillStyle = `rgb(${r},${g},${b})`;
              context.beginPath();
              context.arc(half, half, half, 0, Math.PI * 2);
              context.fill();
            });

            halos[tint] = makeSprite(HALO_SPRITE_HALF, (context, half) => {
              const gradient = context.createRadialGradient(
                half, half, 0, half, half, half,
              );
              gradient.addColorStop(0, `rgba(${r},${g},${b},1)`);
              gradient.addColorStop(1, `rgba(${r},${g},${b},0)`);
              context.fillStyle = gradient;
              context.fillRect(0, 0, half * 2, half * 2);
            });
          });

          return { dots, halos };
        };

        const { dots: dotSprites, halos: haloSprites } = buildSprites();

        // Cull margin must cover the widest halo (r 1.7 × 7 ≈ 12px) so
        // glowing stars don't pop in and out at the viewport edges.
        const CULL_MARGIN = 16;

        // Far / mid / near layers. parallax = how fast the layer follows
        // page scroll (1 would pin it to the content).
        const STAR_LAYERS = [
          { parallax: 0.22, share: 0.5, rMin: 0.35, rMax: 0.85 },
          { parallax: 0.48, share: 0.32, rMin: 0.55, rMax: 1.25 },
          { parallax: 0.78, share: 0.18, rMin: 0.85, rMax: 1.7 },
        ] as const;

        const randomInRange = (min: number, max: number) =>
          Math.random() * (max - min) + min;

        const rollTint = (): StarTint => {
          const roll = Math.random();
          if (roll < 0.62) return 'white';
          if (roll < 0.78) return 'cyan';
          if (roll < 0.92) return 'violet';
          return 'warm';
        };

        let sceneWidth  = window.innerWidth;
        let sceneHeight = window.innerHeight;
        let worldHeight = Math.max(window.innerHeight, document.documentElement.scrollHeight);
        let sceneDpr    = window.devicePixelRatio || 1;

        let starLayers: Star[][] = [[], [], []];
        let meteors: Meteor[]    = [];
        let meteorCountdown      = 4;
        let starFrameId          = 0;
        let starLastFrame        = 0;
        let starResizeTimer      = 0;
        let isLiteMode           = false;
        let liteFrameInterval    = 0; // ms; 0 = uncapped (desktop)

        const resizeStarCanvas = () => {
          if (!(starCanvas instanceof HTMLCanvasElement) || !starCtx) return;
          sceneWidth  = window.innerWidth;
          sceneHeight = window.innerHeight;
          worldHeight = Math.max(sceneHeight, document.documentElement.scrollHeight);
          sceneDpr = Math.min(window.devicePixelRatio || 1, isLiteMode ? 1.5 : 2);
          starCanvas.width  = sceneWidth  * sceneDpr;
          starCanvas.height = sceneHeight * sceneDpr;
          starCanvas.style.width  = `${sceneWidth}px`;
          starCanvas.style.height = `${sceneHeight}px`;
          starCtx.setTransform(sceneDpr, 0, 0, sceneDpr, 0, 0);
        };

        const createStar = (layerIndex: number): Star => {
          const layer = STAR_LAYERS[layerIndex];
          const maxScroll = Math.max(0, worldHeight - sceneHeight);
          const ySpan = sceneHeight + maxScroll * layer.parallax;

          return {
            x: randomInRange(0, sceneWidth),
            y: randomInRange(0, ySpan),
            r: randomInRange(layer.rMin, layer.rMax),
            tint: rollTint(),
            baseAlpha: randomInRange(0.3, 0.9),
            phase: randomInRange(0, Math.PI * 2),
            speed: randomInRange(0.35, 1.6),
            glow: layerIndex === 2 && Math.random() < 0.08,
          };
        };

        const spawnMeteor = (): Meteor => {
          const fromLeft = Math.random() < 0.5;
          const speed = randomInRange(520, 860);
          const angle = randomInRange(Math.PI / 10, Math.PI / 5);

          return {
            x: randomInRange(sceneWidth * 0.05, sceneWidth * 0.95),
            y: randomInRange(-40, sceneHeight * 0.35),
            vx: Math.cos(angle) * speed * (fromLeft ? 1 : -1),
            vy: Math.sin(angle) * speed,
            life: 0,
            maxLife: randomInRange(0.7, 1.2),
          };
        };

        const drawStars = (
          deltaSeconds: number,
          scrollY: number,
          animate: boolean,
        ) => {
          if (!starCtx) return;

          for (let layerIndex = 0; layerIndex < STAR_LAYERS.length; layerIndex += 1) {
            const offset = scrollY * STAR_LAYERS[layerIndex].parallax;

            for (const star of starLayers[layerIndex]) {
              const screenY = star.y - offset;
              if (
                screenY < -CULL_MARGIN ||
                screenY > sceneHeight + CULL_MARGIN
              ) {
                continue;
              }

              if (animate) {
                star.phase += star.speed * deltaSeconds;
                if (star.phase > Math.PI * 2) star.phase -= Math.PI * 2;
              }

              const twinkle = animate
                ? 0.38 + 0.62 * (0.5 + 0.5 * Math.sin(star.phase))
                : 0.75;
              const alpha = star.baseAlpha * twinkle;

              // Soft halo on a few bright near-layer stars (desktop only).
              if (star.glow && !isLiteMode) {
                const haloR = star.r * 7;
                starCtx.globalAlpha = alpha * 0.45;
                starCtx.drawImage(
                  haloSprites[star.tint],
                  star.x - haloR,
                  screenY - haloR,
                  haloR * 2,
                  haloR * 2,
                );
              }

              starCtx.globalAlpha = alpha;
              starCtx.drawImage(
                dotSprites[star.tint],
                star.x - star.r,
                screenY - star.r,
                star.r * 2,
                star.r * 2,
              );
            }
          }

          starCtx.globalAlpha = 1;
        };

        const updateMeteors = (deltaSeconds: number) => {
          if (isLiteMode) return;

          meteorCountdown -= deltaSeconds;
          if (meteorCountdown <= 0 && meteors.length < 2) {
            meteors.push(spawnMeteor());
            meteorCountdown = randomInRange(5, 11);
          }

          for (const meteor of meteors) {
            meteor.life += deltaSeconds;
            meteor.x += meteor.vx * deltaSeconds;
            meteor.y += meteor.vy * deltaSeconds;
          }

          meteors = meteors.filter(
            (meteor) =>
              meteor.life < meteor.maxLife &&
              meteor.y < sceneHeight + 90 &&
              meteor.x > -160 &&
              meteor.x < sceneWidth + 160,
          );
        };

        const drawMeteors = () => {
          if (!starCtx) return;

          for (const meteor of meteors) {
            const progress = meteor.life / meteor.maxLife;
            const alpha = Math.sin(Math.PI * progress) * 0.85;
            const magnitude = Math.hypot(meteor.vx, meteor.vy) || 1;
            const tailX = meteor.x - (meteor.vx / magnitude) * 120;
            const tailY = meteor.y - (meteor.vy / magnitude) * 120;

            const trail = starCtx.createLinearGradient(
              meteor.x, meteor.y, tailX, tailY,
            );
            trail.addColorStop(0, `rgba(214,240,255,${alpha.toFixed(3)})`);
            trail.addColorStop(1, 'rgba(214,240,255,0)');

            starCtx.strokeStyle = trail;
            starCtx.lineWidth = 1.6;
            starCtx.lineCap = 'round';
            starCtx.beginPath();
            starCtx.moveTo(meteor.x, meteor.y);
            starCtx.lineTo(tailX, tailY);
            starCtx.stroke();

            starCtx.globalAlpha = alpha;
            starCtx.fillStyle = '#eaf6ff';
            starCtx.beginPath();
            starCtx.arc(meteor.x, meteor.y, 1.7, 0, Math.PI * 2);
            starCtx.fill();
            starCtx.globalAlpha = 1;
          }
        };

        const animateStarfield = (timestamp: number) => {
          if (!starCtx) return;

          // Lite mode: cap at 30 fps — skip frame if too soon
          if (liteFrameInterval > 0 && timestamp - starLastFrame < liteFrameInterval - 1) {
            starFrameId = window.requestAnimationFrame(animateStarfield);
            return;
          }

          const deltaSeconds = Math.min(
            0.05,
            Math.max(0.001, (timestamp - starLastFrame) / 1000),
          );
          starLastFrame = timestamp;

          starCtx.clearRect(0, 0, sceneWidth, sceneHeight);
          drawStars(deltaSeconds, window.scrollY, true);
          updateMeteors(deltaSeconds);
          drawMeteors();

          starFrameId = window.requestAnimationFrame(animateStarfield);
        };

        const rebuildStarfield = () => {
          if (!(starCanvas instanceof HTMLCanvasElement) || !starCtx) return;

          sceneWidth  = window.innerWidth;
          worldHeight = Math.max(window.innerHeight, document.documentElement.scrollHeight);
          isLiteMode  = sceneWidth < 768;
          liteFrameInterval = isLiteMode ? 1000 / 30 : 0;

          window.cancelAnimationFrame(starFrameId);
          resizeStarCanvas();

          // Density: px² of viewport per star; star counts scale with each
          // layer's scrollable span so on-screen density stays consistent.
          const density = isLiteMode ? 15000 : 9000;
          const baseCount = (sceneWidth * sceneHeight) / density;
          const maxScroll = Math.max(0, worldHeight - sceneHeight);

          starLayers = STAR_LAYERS.map((layer, layerIndex) => {
            const ySpan = sceneHeight + maxScroll * layer.parallax;
            const count = Math.round((baseCount * layer.share * ySpan) / sceneHeight);
            return Array.from({ length: count }, () => createStar(layerIndex));
          });
          meteors = [];

          // Reduced motion: render a single static frame instead of animating.
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            starCtx.clearRect(0, 0, sceneWidth, sceneHeight);
            drawStars(0, window.scrollY, false);
            return;
          }

          starLastFrame = performance.now();
          starFrameId   = window.requestAnimationFrame(animateStarfield);
        };

        rebuildStarfield();
        // Rebuild once more after full page load so worldHeight reflects
        // final layout (fonts, images may shift it from the initial value).
        window.addEventListener('load', rebuildStarfield, { once: true });

        window.addEventListener('resize', () => {
          window.clearTimeout(starResizeTimer);
          starResizeTimer = window.setTimeout(rebuildStarfield, 200);
        });

        if (navLinks.length === 0) {
          return;
        }

        let closeMobileMenu = () => {};

        if (
          headerElement &&
          navToggleButton &&
          navList instanceof HTMLElement
        ) {
          const setMobileMenuOpen = (isOpen: boolean) => {
            navToggleButton.setAttribute('aria-expanded', String(isOpen));
            navToggleButton.setAttribute(
              'aria-label',
              isOpen ? 'Close navigation menu' : 'Open navigation menu',
            );

            if (isOpen) {
              headerElement.setAttribute('data-menu-open', '');
            } else {
              headerElement.removeAttribute('data-menu-open');
            }
          };

          closeMobileMenu = () => {
            setMobileMenuOpen(false);
          };

          navToggleButton.addEventListener('click', () => {
            const isOpen =
              navToggleButton.getAttribute('aria-expanded') === 'true';
            setMobileMenuOpen(!isOpen);
          });

          navLinks.forEach((link) => {
            link.addEventListener('click', () => {
              if (!desktopMediaQuery.matches) {
                closeMobileMenu();
              }
            });
          });

          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
              closeMobileMenu();
            }
          });

          desktopMediaQuery.addEventListener('change', (event) => {
            if (event.matches) {
              closeMobileMenu();
            }
          });

          closeMobileMenu();
        }

        const sections = navLinks
          .map((link) => {
            const href = link.getAttribute('href');

            if (!href || !href.startsWith('#')) {
              return null;
            }

            return document.querySelector(href);
          })
          .filter(
            (section): section is HTMLElement => section instanceof HTMLElement,
          );

        if (sections.length === 0) {
          return;
        }

        const sectionIds = new Set(sections.map((section) => section.id));
        let activeSectionId = '';

        const getHeaderOffset = () =>
          headerElement ? headerElement.getBoundingClientRect().height : 64;

        const setActiveLink = (sectionId: string) => {
          if (!sectionId || sectionId === activeSectionId) {
            return;
          }

          activeSectionId = sectionId;

          navLinks.forEach((link) => {
            const href = link.getAttribute('href');
            const isActive = href === `#${sectionId}`;

            link.classList.toggle('is-active', isActive);

            if (isActive) {
              link.setAttribute('aria-current', 'true');
            } else {
              link.removeAttribute('aria-current');
            }
          });
        };

        const hashSectionId = () => window.location.hash.replace('#', '');

        navLinks.forEach((link) => {
          link.addEventListener('click', () => {
            const targetId = (link.getAttribute('href') ?? '').replace('#', '');

            if (!sectionIds.has(targetId)) {
              return;
            }

            setActiveLink(targetId);
          });
        });

        const syncHeaderScrolledState = () => {
          if (!headerElement) {
            return;
          }

          if (window.scrollY > 8) {
            headerElement.setAttribute('data-scrolled', '');
          } else {
            headerElement.removeAttribute('data-scrolled');
          }
        };

        const syncActiveFromScroll = () => {
          const headerOffset = getHeaderOffset();
          const nearPageBottom =
            window.innerHeight + window.scrollY >=
            document.documentElement.scrollHeight - 2;
          const hashId = hashSectionId();

          if (nearPageBottom && sectionIds.has(hashId)) {
            setActiveLink(hashId);
            return;
          }

          const referenceLine =
            headerOffset + (window.innerHeight - headerOffset) * 0.35;

          const sectionAtReferenceLine = sections.find((section) => {
            const bounds = section.getBoundingClientRect();

            return bounds.top <= referenceLine && bounds.bottom > referenceLine;
          });

          if (sectionAtReferenceLine) {
            setActiveLink(sectionAtReferenceLine.id);
            return;
          }

          let currentSection = sections[0];

          for (const section of sections) {
            if (section.getBoundingClientRect().top <= referenceLine) {
              currentSection = section;
            } else {
              break;
            }
          }

          setActiveLink(currentSection.id);
        };

        const syncActiveFromHash = () => {
          const sectionId = hashSectionId();

          if (sectionIds.has(sectionId)) {
            setActiveLink(sectionId);
            window.requestAnimationFrame(syncActiveFromScroll);
            return;
          }

          syncActiveFromScroll();
        };

        let isScrollSyncScheduled = false;

        const syncOnScroll = () => {
          if (isScrollSyncScheduled) {
            return;
          }

          isScrollSyncScheduled = true;

          window.requestAnimationFrame(() => {
            syncHeaderScrolledState();
            syncActiveFromScroll();
            isScrollSyncScheduled = false;
          });
        };

        syncHeaderScrolledState();
        syncActiveFromHash();

        window.addEventListener('hashchange', () => {
          if (!desktopMediaQuery.matches) {
            closeMobileMenu();
          }

          syncActiveFromHash();
        });

        window.addEventListener('resize', () => {
          window.requestAnimationFrame(syncActiveFromScroll);
        });

        window.addEventListener('scroll', syncOnScroll, {
          passive: true,
        });
      })();
    </script>

    <script>
      // Scroll reveal: cascading boot-up for cards and headings.
      (() => {
        const prefersReducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;

        if (prefersReducedMotion || !('IntersectionObserver' in window)) {
          return;
        }

        const targets = Array.from(
          document.querySelectorAll(
            [
              '.section-block > h2',
              '.section-path',
              '.card-surface',
              '.experience-entry',
              '.skills-ledger-row',
              '.certification-item',
              '.contact-link-card',
              '.terminal-window',
              '.tools-rail',
            ].join(', '),
          ),
        ).filter(
          (element): element is HTMLElement => element instanceof HTMLElement,
        );

        if (targets.length === 0) {
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) {
                continue;
              }

              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -36px' },
        );

        targets.forEach((element) => {
          // Stagger siblings slightly for a cascading feel.
          const siblings = element.parentElement
            ? Array.from(element.parentElement.children)
            : [];
          const index = Math.max(0, siblings.indexOf(element));

          element.style.setProperty(
            '--reveal-delay',
            `${Math.min(index % 8, 5) * 55}ms`,
          );
          element.classList.add('reveal');
          observer.observe(element);
        });
      })();
    </script>
  </body>
</html>
