---
import MainLayout from '../layouts/MainLayout.astro';
import {
  certifications,
  coreTools,
  experienceTimeline,
  skillGroups,
} from '../data/profile';
import { dateRange, getSortedProjects } from '../lib/projects';

const normalizeMarkdownExcerpt = (value: string) =>
  value
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/^\s*[-*+]\s+/gm, '')
    .replace(/^\s*\d+\.\s+/gm, '')
    .replace(/\n+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const escapeRegExp = (value: string) =>
  value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

const extractNarrativeSection = (body: string, heading: string) => {
  const sectionPattern = new RegExp(
    `^##\\s+${escapeRegExp(heading)}\\s*$([\\s\\S]*?)(?=^##\\s+\\w[\\w\\s-]*\\s*$|(?![\\s\\S]))`,
    'im',
  );

  const sectionMatch = body.match(sectionPattern);

  return sectionMatch ? normalizeMarkdownExcerpt(sectionMatch[1]) : '';
};

const toProjectNarrative = (
  body: string,
  summary: string,
  impact: string[],
) => ({
  problem: extractNarrativeSection(body, 'Problem') || summary,
  approach:
    extractNarrativeSection(body, 'Approach') ||
    'Implemented with a reliability-first cloud architecture and automation focus.',
  result: extractNarrativeSection(body, 'Result') || impact[0] || summary,
});

const projects = (await getSortedProjects()).map((project) => ({
  ...project,
  narrative: toProjectNarrative(
    project.body ?? '',
    project.data.summary,
    project.data.impact,
  ),
}));

const toStackFilterValue = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const stackOptions = Array.from(
  new Set(projects.flatMap((project) => project.data.stack)),
).sort((a, b) => a.localeCompare(b));

const laneLabel = (lane: 'professional' | 'personal') =>
  lane.charAt(0).toUpperCase() + lane.slice(1);
---

<MainLayout
  title="Senad Dizdarević — AWS DevOps & Cloud Engineer"
  description="Senad Dizdarević, AWS-certified DevOps and cloud engineer. Secure automation, reliable delivery pipelines, and measurable cloud outcomes."
>
  <section
    id="home"
    class="section-anchor section-block"
    aria-labelledby="home-title"
  >
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="section-kicker">Helping teams build with confidence</p>
        <h1
          id="home-title"
          class="hero-title max-w-3xl text-4xl font-semibold tracking-tight md:text-5xl"
        >
          Reliable systems that help your business move forward
        </h1>
        <p
          class="hero-lead mt-5 text-base text-[color:var(--text-300)] md:text-lg"
        >
          I build secure, dependable systems and automate repetitive work, so
          your team can spend less time fixing problems and more time serving
          customers.
        </p>

        <div class="hero-actions mt-8 flex flex-wrap gap-3">
          <a href="#projects" class="button-primary focus-ring">View projects</a
          >
          <a href="#contact" class="button-secondary focus-ring">Contact</a>
        </div>
      </div>

      <div
        class="terminal-window hero-terminal"
        data-hero-terminal
        role="region"
        aria-label="Portfolio snapshot"
      >
        <div class="terminal-titlebar">
          <span class="terminal-dot terminal-dot--close"></span>
          <span class="terminal-dot terminal-dot--min"></span>
          <span class="terminal-dot terminal-dot--max"></span>
          <span class="terminal-title">senad@cloud: ~/portfolio</span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line" data-terminal-line data-line-type="cmd">
            <span class="terminal-prompt">❯</span><span class="terminal-cmd">
              whoami</span
            >
          </div>
          <div
            class="terminal-line terminal-output"
            data-terminal-line
            data-line-type="out"
          >
            senad — devops & cloud engineer · aws certified
          </div>
          <div class="terminal-line" data-terminal-line data-line-type="cmd">
            <span class="terminal-prompt">❯</span><span class="terminal-cmd">
              terraform apply -auto-approve</span
            >
          </div>
          <div
            class="terminal-line terminal-output terminal-output--ok"
            data-terminal-line
            data-line-type="out"
          >
            Apply complete! Resources: 128 added, 0 changed, 0 destroyed.
          </div>
          <div class="terminal-line" data-terminal-line data-line-type="cmd">
            <span class="terminal-prompt">❯</span><span class="terminal-cmd">
              ./deploy.sh --env production</span
            >
          </div>
          <div
            class="terminal-line terminal-output terminal-output--ok"
            data-terminal-line
            data-line-type="out"
          >
            ✔ pipeline green · zero-downtime release
          </div>
          <div class="terminal-line" data-terminal-line data-line-type="cmd">
            <span class="terminal-prompt">❯</span><span class="terminal-cursor"
              >▊</span
            >
          </div>
        </div>
      </div>
    </div>

    <ul class="hero-outcomes" role="list" data-hero-outcomes>
      <li class="hero-outcome card-surface">
        <h2>Hiring teams</h2>
        <p>
          End-to-end platform ownership across architecture, delivery, and day-2
          operations.
        </p>
      </li>
      <li class="hero-outcome card-surface">
        <h2>Freelance clients</h2>
        <p>
          Production-ready foundations with practical automation and clear,
          transparent delivery communication.
        </p>
      </li>
      <li class="hero-outcome card-surface">
        <h2>Shared outcome</h2>
        <p>
          Faster releases, fewer operational surprises, and maintainable cloud
          systems.
        </p>
      </li>
    </ul>
  </section>

  <section
    id="projects"
    class="section-anchor section-block"
    aria-labelledby="projects-title"
  >
    <h2 id="projects-title" class="text-2xl font-semibold md:text-3xl">
      Projects
    </h2>
    <p class="mt-3 max-w-2xl text-[color:var(--text-300)]">
      Cloud platforms, delivery automation, and open-source tooling, ordered by
      recency. Filter the complete collection by work type or stack.
    </p>

    <div class="project-filters mt-6" data-project-filters>
      <div class="project-filter-bar">
        <!-- Lane: always-visible segmented tabs -->
        <div class="project-lane-tabs" role="group" aria-label="Filter by lane">
          <label class="lane-tab" for="lane-filter-all">
            <input
              id="lane-filter-all"
              class="lane-tab-input"
              type="radio"
              name="lane-filter"
              value="all"
              data-lane-option
            />
            <span>All</span>
          </label>
          <label class="lane-tab" for="lane-filter-professional">
            <input
              id="lane-filter-professional"
              class="lane-tab-input"
              type="radio"
              name="lane-filter"
              value="professional"
              data-lane-option
              checked
            />
            <span>Professional</span>
          </label>
          <label class="lane-tab" for="lane-filter-personal">
            <input
              id="lane-filter-personal"
              class="lane-tab-input"
              type="radio"
              name="lane-filter"
              value="personal"
              data-lane-option
            />
            <span>Personal</span>
          </label>
        </div>

        <!-- Stack: separate dropdown trigger -->
        <div class="project-stack-wrapper">
          <button
            type="button"
            class="project-stack-trigger focus-ring"
            data-filter-trigger
            aria-expanded="false"
            aria-controls="projects-filter-menu"
          >
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="4" y1="6" x2="20" y2="6"></line>
              <line x1="8" y1="12" x2="16" y2="12"></line>
              <line x1="11" y1="18" x2="13" y2="18"></line>
            </svg>
            <span>Stack</span>
            <span class="project-stack-count" data-filter-summary-label hidden
            ></span>
            <span class="project-filter-trigger-chevron" aria-hidden="true"
              >▾</span
            >
          </button>

          <div
            id="projects-filter-menu"
            class="project-filter-menu"
            data-filter-menu
            role="region"
            aria-labelledby="projects-filter-menu-title"
            aria-describedby="projects-filter-menu-hint"
            hidden
          >
            <div class="project-filter-stack-header">
              <p
                id="projects-filter-menu-title"
                class="project-filter-section-title"
              >
                Stack
              </p>
              <button
                type="button"
                class="project-filter-clear focus-ring"
                data-stack-clear
              >
                Clear
              </button>
            </div>
            <p
              id="projects-filter-menu-hint"
              class="project-filter-helper-text"
            >
              Select one or multiple.
            </p>

            <ul class="project-filter-stack-options" role="list">
              {
                stackOptions.map((stack) => {
                  const stackValue = toStackFilterValue(stack);
                  const stackOptionId = `stack-filter-${stackValue}`;

                  return (
                    <li>
                      <label class="project-filter-option" for={stackOptionId}>
                        <input
                          id={stackOptionId}
                          type="checkbox"
                          value={stackValue}
                          data-stack-option
                          data-stack-label={stack}
                        />
                        <span>{stack}</span>
                      </label>
                    </li>
                  );
                })
              }
            </ul>
          </div>
        </div>
      </div>
    </div>

    <p
      class="project-results mt-6 text-sm text-[color:var(--text-300)]"
      aria-live="polite"
      data-filter-status
    >
    </p>

    <ul
      id="project-list"
      class="project-grid mt-6 grid gap-4"
      role="list"
      data-project-list
    >
      {
        projects.map((project) => (
          <li
            class="project-card card-surface p-5"
            data-project-item
            data-project-lane={project.data.lane}
            data-project-stacks={project.data.stack
              .map((item) => toStackFilterValue(item))
              .join('|')}
          >
            <div class="project-card-meta">
              <span class="pill-chip" data-lane={project.data.lane}>
                {laneLabel(project.data.lane)}
              </span>
              <span class="project-card-date">
                {dateRange(project.data.startDate, project.data.endDate)}
              </span>
            </div>

            <h3 class="project-card-title mt-4 text-xl font-semibold tracking-tight text-[color:var(--text-100)]">
              {project.data.title}
            </h3>
            <p class="project-card-summary mt-3 text-sm text-[color:var(--text-300)]">
              {project.data.summary}
            </p>

            <ul
              class="project-card-stack mt-4 flex flex-wrap gap-2"
              role="list"
            >
              {project.data.stack.slice(0, 4).map((item) => (
                <li class="pill-chip">{item}</li>
              ))}
              {project.data.stack.length > 4 && (
                <li class="pill-chip pill-chip--subtle">
                  +{project.data.stack.length - 4} more
                </li>
              )}
            </ul>

            <details class="details-panel mt-3" data-project-details>
              <summary class="details-summary focus-ring">
                <span class="details-summary-main">
                  <span class="details-summary-chevron" aria-hidden="true">
                    ▸
                  </span>
                  <span class="details-summary-label">Details</span>
                </span>
              </summary>

              <div class="details-content">
                <dl class="project-story" role="list">
                  <div class="project-story-item">
                    <dt class="project-story-term">
                      <span
                        class="project-story-icon project-story-icon--problem"
                        aria-hidden="true"
                      />
                      Problem
                    </dt>
                    <dd class="project-story-text">
                      {project.narrative.problem}
                    </dd>
                  </div>
                  <div class="project-story-item">
                    <dt class="project-story-term">
                      <span
                        class="project-story-icon project-story-icon--approach"
                        aria-hidden="true"
                      />
                      Approach
                    </dt>
                    <dd class="project-story-text">
                      {project.narrative.approach}
                    </dd>
                  </div>
                  <div class="project-story-item">
                    <dt class="project-story-term">
                      <span
                        class="project-story-icon project-story-icon--result"
                        aria-hidden="true"
                      />
                      Result
                    </dt>
                    <dd class="project-story-text">
                      {project.narrative.result}
                    </dd>
                  </div>
                </dl>

                <p class="details-kicker text-xs uppercase tracking-[0.12em] text-[color:var(--text-300)]">
                  Full stack
                </p>
                <ul
                  class="details-stack-list mt-3 flex flex-wrap gap-2"
                  role="list"
                >
                  {project.data.stack.map((item) => (
                    <li class="pill-chip">{item}</li>
                  ))}
                </ul>

                <p class="details-kicker text-xs uppercase tracking-[0.12em] text-[color:var(--text-300)]">
                  Impact
                </p>
                <ul
                  class="details-impact-list mt-3 list-disc space-y-2 pl-5 text-sm text-[color:var(--text-300)]"
                  role="list"
                >
                  {project.data.impact.map((impactPoint) => (
                    <li>{impactPoint}</li>
                  ))}
                </ul>

                <div class="details-actions mt-4 flex flex-wrap gap-2">
                  {project.data.links.github && (
                    <a
                      href={project.data.links.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="button-secondary focus-ring"
                      aria-label="View project source code"
                    >
                      View code
                    </a>
                  )}
                  {project.data.links.npm && (
                    <a
                      href={project.data.links.npm}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="button-secondary focus-ring"
                      aria-label="Open npm package"
                    >
                      npm package
                    </a>
                  )}
                  {project.data.links.live && (
                    <a
                      href={project.data.links.live}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="button-secondary focus-ring"
                      aria-label="Open live project"
                    >
                      Live project
                    </a>
                  )}
                  {project.data.links.caseStudy && (
                    <a
                      href={project.data.links.caseStudy}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="button-secondary focus-ring"
                      aria-label="Open project case study"
                    >
                      Case study
                    </a>
                  )}
                </div>
              </div>
            </details>
          </li>
        ))
      }
    </ul>

    <p
      class="mt-5 text-sm text-[color:var(--text-300)]"
      data-project-empty
      hidden
    >
      No projects match this filter yet.
    </p>
  </section>

  <section
    id="experience"
    class="section-anchor section-block"
    aria-labelledby="experience-title"
  >
    <h2 id="experience-title" class="text-2xl font-semibold md:text-3xl">
      Experience
    </h2>
    <p class="mb-6 mt-3 max-w-3xl text-[color:var(--text-300)]">
      Experience includes full-time DevOps progression at Valcon, freelance AWS
      delivery through Upwork, and earlier operations leadership at INA Grupa.
    </p>

    <ol class="experience-timeline" role="list">
      {
        experienceTimeline.map((item) => (
          <li class="experience-entry">
            <div class="experience-header">
              <div>
                <h3 class="text-lg font-semibold text-[color:var(--text-100)]">
                  {item.role}
                </h3>
                <p class="mt-1 text-sm text-[color:var(--text-300)]">
                  {item.company}
                </p>
              </div>

              <p class="experience-period">{item.period}</p>
            </div>

            <ul class="experience-highlights" role="list">
              {item.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <section
    id="skills"
    class="section-anchor section-block"
    aria-labelledby="skills-title"
  >
    <h2 id="skills-title" class="text-2xl font-semibold md:text-3xl">Skills</h2>
    <p class="mt-3 max-w-3xl text-[color:var(--text-300)]">
      Production-focused tooling used across full-time and freelance cloud
      delivery projects.
    </p>

    <ul class="skills-ledger" role="list">
      {
        skillGroups.map((group) => (
          <li class="skills-ledger-row">
            <h3 class="skills-ledger-title">{group.title}</h3>
            <ul class="skills-ledger-tags" role="list">
              {group.items.map((item) => (
                <li class="pill-chip">{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    id="certifications"
    class="section-anchor section-block"
    aria-labelledby="certifications-title"
  >
    <h2 id="certifications-title" class="text-2xl font-semibold md:text-3xl">
      Certifications
    </h2>

    <div class="certifications-layout mt-6">
      <ul class="certification-list" role="list">
        {
          certifications.map((certification) => (
            <li class="certification-item">
              <h3 class="certification-title">{certification.title}</h3>
              <p class="certification-issuer">{certification.issuer}</p>

              <dl class="certification-meta">
                <div class="certification-meta-row">
                  <dt>Issued</dt>
                  <dd>{certification.issued}</dd>
                </div>
                <div class="certification-meta-row">
                  <dt>Credential ID</dt>
                  <dd>{certification.credentialId}</dd>
                </div>
              </dl>

              {certification.credentialUrl && (
                <a
                  href={certification.credentialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="certification-verify-link focus-ring"
                >
                  Verify credential
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <aside class="tools-rail" aria-labelledby="tools-rail-title">
        <h3 id="tools-rail-title" class="tools-rail-title">
          Core tools used in delivery
        </h3>
        <ul class="tools-rail-list" role="list">
          {coreTools.map((tool) => <li class="pill-chip">{tool}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section
    id="about"
    class="section-anchor section-block"
    aria-labelledby="about-title"
  >
    <h2 id="about-title" class="text-2xl font-semibold md:text-3xl">About</h2>
    <p class="mt-3 max-w-3xl text-[color:var(--text-300)]">
      I work in two delivery modes: embedded partner for hiring teams and
      focused consultant for freelance clients. In both cases, the goal is the
      same simple architecture first, reliable automation, strong security
      posture, and clear operational ownership after handover.
    </p>

    <ul class="mt-6 grid gap-4 md:grid-cols-3" role="list">
      <li class="card-surface p-4">
        <h3
          class="text-sm font-semibold uppercase tracking-[0.08em] text-cyan-300"
        >
          For hiring managers
        </h3>
        <p class="mt-2 text-sm text-[color:var(--text-300)]">
          Dependable ownership from platform design to stable day-2 operations.
        </p>
      </li>
      <li class="card-surface p-4">
        <h3
          class="text-sm font-semibold uppercase tracking-[0.08em] text-cyan-300"
        >
          For engineering teams
        </h3>
        <p class="mt-2 text-sm text-[color:var(--text-300)]">
          Practical CI/CD and infrastructure automation that removes bottlenecks
          without overengineering.
        </p>
      </li>
      <li class="card-surface p-4">
        <h3
          class="text-sm font-semibold uppercase tracking-[0.08em] text-cyan-300"
        >
          For freelance clients
        </h3>
        <p class="mt-2 text-sm text-[color:var(--text-300)]">
          Security-first AWS delivery focused on measurable business outcomes
          and long-term maintainability.
        </p>
      </li>
    </ul>
  </section>

  <section
    id="contact"
    class="section-anchor section-block"
    aria-labelledby="contact-title"
  >
    <h2 id="contact-title" class="text-2xl font-semibold md:text-3xl">
      Contact
    </h2>

    <nav class="contact-links mt-6" aria-label="Contact and social links">
      <a
        href="mailto:senad.dizdarevic.ri@gmail.com"
        class="contact-link-card contact-link-card--email focus-ring"
      >
        <span class="contact-link-icon" aria-hidden="true">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="2" y="4" width="20" height="16" rx="2"></rect><path
              d="m2 7 10 7 10-7"></path></svg
          >
        </span>
        <span class="contact-link-body">
          <span class="contact-link-name">Email</span>
          <span class="contact-link-hint">Direct message · 24h response</span>
        </span>
        <span class="contact-link-arrow" aria-hidden="true">→</span>
      </a>

      <a
        href="https://www.upwork.com/freelancers/~017a10028c45b2150f?utm_source=portfolio&utm_medium=website&utm_campaign=contact_cta"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-link-card contact-link-card--upwork focus-ring"
      >
        <span class="contact-link-icon" aria-hidden="true">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="2" y="7" width="20" height="14" rx="2"></rect><path
              d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path><line
              x1="12"
              y1="12"
              x2="12"
              y2="12.01"></line></svg
          >
        </span>
        <span class="contact-link-body">
          <span class="contact-link-name">Upwork</span>
          <span class="contact-link-hint">Freelance engagements</span>
        </span>
        <span class="contact-link-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        href="https://www.linkedin.com/in/senad-dizdarevic-devops"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-link-card contact-link-card--linkedin focus-ring"
      >
        <span class="contact-link-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
            ></path><rect x="2" y="9" width="4" height="12"></rect><circle
              cx="4"
              cy="4"
              r="2"></circle></svg
          >
        </span>
        <span class="contact-link-body">
          <span class="contact-link-name">LinkedIn</span>
          <span class="contact-link-hint">Professional profile</span>
        </span>
        <span class="contact-link-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        href="https://github.com/senad-d"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-link-card contact-link-card--github focus-ring"
      >
        <span class="contact-link-icon" aria-hidden="true">
